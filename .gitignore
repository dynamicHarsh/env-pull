# ── Compiled binaries ────────────────────────────────────────────────────────
bin/
# GoReleaser build output — never commit compiled artifacts
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# ── Go test & coverage artifacts ─────────────────────────────────────────────
*.test
*.out
*.pprof
coverage.txt
coverage.html

# ── Go workspace (local multi-module development) ─────────────────────────────
go.work
go.work.sum

# ── Vendored dependencies (only if not intentionally vendoring) ───────────────
vendor/

# ── Build / tool caches ───────────────────────────────────────────────────────
.cache/

# ── Secret & environment files — NEVER commit plaintext secrets ───────────────
# .env.* covers .env.pull.enc (the encrypted local vault) and any .env.* files.
# Committing the vault is safe cryptographically, but it is user-specific;
# keep it local unless your team explicitly decides to share it in the repo.
.env
.env.*
*.env

# ── Node.js / web frontend (website/) ────────────────────────────────────────
# website/ is a plain directory in this repo (no longer a submodule).
# These patterns apply tree-wide so node_modules anywhere is excluded.
node_modules/
# Next.js build cache and output
.next/
# Next.js static export output
out/
.pnp
.pnp.*
# TypeScript incremental build info (generated, not source)
*.tsbuildinfo

# ── Editor and IDE artifacts ──────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.suo
*.user

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
